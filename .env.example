# Example environment variables for local development
# Enable client-side face-api.js expression detection (true/false)
VITE_USE_FACE_API=true

# Base URL for the analysis API (used when sending images/text to the server)
VITE_API_BASE_URL=http://localhost:5050

# If models are hosted locally under `public/models`, set this to /models (optional)
# VITE_FACE_MODEL_PATH=/models
